# 실제 값은 .env.local 파일에 넣고, 이 파일에는 이름만 적어 둔다.
# .env.local은 GitHub에 올라가지 않는다.

# Supabase (프로젝트 설정 > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI 장소 요약: 카카오 검색으로 찾고 Gemini가 요약 (둘 다 있어야 켜짐)
# Gemini: Google AI Studio > Get API key (결제 연결 안 함, 무료 API는 구글 검색 불가라 검색 끈 상태로 씀)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (카카오맵 제품 사용 설정 필요)
KAKAO_REST_API_KEY=
