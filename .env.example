# 실제 값은 .env.local 파일에 넣고, 이 파일에는 이름만 적어 둔다.
# .env.local은 GitHub에 올라가지 않는다.

# Supabase (프로젝트 설정 > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI 장소 요약: 네이버 검색으로 찾고 Gemini가 요약 (셋 다 있어야 켜짐)
# Gemini: Google AI Studio > Get API key (결제 연결 안 함, 무료 API는 구글 검색 불가라 검색 끈 상태로 씀)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
